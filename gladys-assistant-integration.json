{
  "manifest_version": 1,
  "type": "device",
  "name": "UBA Air Quality",
  "description": {
    "en": "Official German air quality (Umweltbundesamt): index and pollutants of the stations, hour by hour.",
    "fr": "Qualité de l'air officielle allemande (UBA) : indice et polluants des stations, heure par heure.",
    "de": "Offizielle Luftqualität des Umweltbundesamts: Index und Schadstoffe der Messstationen, stündlich.",
    "es": "Calidad del aire oficial alemana (UBA): índice y contaminantes de las estaciones, cada hora."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-uba-air:1.0.0",
  "gladys_version": ">=5.3.0",
  "countries": ["DE"],
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-uba-air/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "German air quality stations",
        "fr": "Stations allemandes de qualité de l'air",
        "de": "Luftqualitäts-Messstationen in Deutschland",
        "es": "Estaciones alemanas de calidad del aire"
      },
      "description": {
        "en": "Reads the official measuring stations of the German states, with the air quality index of the Umweltbundesamt (UBA), through its open API (no account). Not affiliated with UBA.",
        "fr": "Lit les stations de mesure officielles des Länder allemands, avec l'indice de qualité de l'air de l'Umweltbundesamt (UBA), par son API ouverte (sans compte). Non affilié à l'UBA.",
        "de": "Liest die offiziellen Messstationen der Länder mit dem Luftqualitätsindex des Umweltbundesamts (UBA) über seine offene API (ohne Konto). Nicht mit dem UBA verbunden.",
        "es": "Lee las estaciones de medición oficiales de los Länder alemanes, con el índice de calidad del aire del Umweltbundesamt (UBA), mediante su API abierta (sin cuenta). Sin afiliación con la UBA."
      },
      "links": [
        {
          "url": "https://www.umweltbundesamt.de/daten/luft/luftdaten/luftqualitaet",
          "label": {
            "en": "Map of the stations",
            "fr": "Carte des stations",
            "de": "Karte der Stationen",
            "es": "Mapa de las estaciones"
          }
        },
        {
          "url": "https://luftdaten.umweltbundesamt.de/api/air-data/v4/doc",
          "label": {
            "en": "The UBA API",
            "fr": "L'API de l'UBA",
            "de": "Die UBA-API",
            "es": "La API de la UBA"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "The numbers of the UBA stations to read, separated by commas (10 at most). The \"Find a station\" button below gives them, by name, city, code or around a house.",
        "fr": "Les numéros des stations de l'UBA à lire, séparés par des virgules (10 au plus). Le bouton « Trouver une station » ci-dessous les donne, par nom, ville, code ou autour d'une maison.",
        "de": "Die Nummern der zu lesenden UBA-Stationen, durch Kommas getrennt (höchstens 10). Der Button „Station finden“ unten liefert sie, nach Name, Stadt, Code oder in der Nähe eines Hauses.",
        "es": "Los números de las estaciones de la UBA que desea leer, separados por comas (10 como máximo). El botón «Buscar una estación» más abajo se los da, por nombre, ciudad, código o alrededor de una casa."
      },
      "placeholder": {
        "en": "e.g. 121, 21",
        "fr": "ex. 121, 21",
        "de": "z. B. 121, 21",
        "es": "p. ej. 121, 21"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh",
        "fr": "Relevé",
        "de": "Abruf",
        "es": "Lectura"
      },
      "description": {
        "en": "UBA publishes each hour once the states have sent it, often one to two hours later.",
        "fr": "L'UBA publie chaque heure une fois transmise par les Länder, souvent une à deux heures plus tard.",
        "de": "Das UBA veröffentlicht jede Stunde, sobald die Länder sie liefern, oft ein bis zwei Stunden später.",
        "es": "La UBA publica cada hora una vez que los Länder la transmiten, a menudo una o dos horas después."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added) and of the scene texts.",
        "fr": "Langue des noms de fonctionnalités (fixés à l'ajout d'un appareil) et des textes de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt) und der Szenentexte.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo) y de los textos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "find_station",
      "label": {
        "en": "Find a station",
        "fr": "Trouver une station",
        "de": "Station finden",
        "es": "Buscar una estación"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Name, city or code",
            "fr": "Nom, ville ou code",
            "de": "Name, Stadt oder Code",
            "es": "Nombre, ciudad o código"
          },
          "description": {
            "en": "Accents are optional. Empty: the active stations nearest to the house.",
            "fr": "Les accents sont facultatifs. Vide : les stations actives les plus proches de la maison.",
            "de": "Umlaute sind optional. Leer: die aktiven Stationen, die dem Haus am nächsten sind.",
            "es": "Los acentos son opcionales. Vacío: las estaciones activas más cercanas a la casa."
          },
          "placeholder": {
            "en": "e.g. Köln",
            "fr": "ex. Köln",
            "de": "z. B. Köln",
            "es": "p. ej. Köln"
          },
          "required": false
        },
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison",
            "de": "Haus",
            "es": "Casa"
          },
          "description": {
            "en": "Sorts by distance. Its location is set in Settings → Houses. Empty: the first located house when no name is typed.",
            "fr": "Trie par distance. Sa position se règle dans Paramètres → Maisons. Vide : la première maison située si aucun nom n'est saisi.",
            "de": "Sortiert nach Entfernung. Sein Standort wird unter Einstellungen → Zuhause festgelegt. Leer: das erste Haus mit Standort, wenn kein Name eingegeben ist.",
            "es": "Ordena por distancia. Su ubicación se define en Configuración → Viviendas. Vacío: la primera casa con ubicación si no escribe ningún nombre."
          },
          "required": false
        }
      ]
    },
    {
      "key": "check_stations",
      "label": {
        "en": "Check the stations",
        "fr": "Vérifier les stations",
        "de": "Stationen prüfen",
        "es": "Comprobar las estaciones"
      },
      "timeout_seconds": 240
    }
  ],
